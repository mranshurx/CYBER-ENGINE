<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bg"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Copy Paster"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:paddingTop="12dp"
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku: checking..."
            android:textColor="#B9C4D8"
            android:textSize="13sp"
            android:paddingBottom="20dp" />

        <Button
            android:id="@+id/requestPermissionButton"
            style="@style/PremiumButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Grant Shizuku Permission" />

        <Button
            android:id="@+id/pickFileButton"
            style="@style/PremiumButton.Outline"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:text="Choose Files to Copy" />

        <TextView
            android:id="@+id/selectedFileText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No files selected"
            android:textColor="#B9C4D8"
            android:textSize="13sp"
            android:paddingTop="10dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:boxStrokeColor="#7AA6FF"
            app:hintTextColor="#7AA6FF"
            android:textColorHint="#8894A8">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/destPathEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Destination path (e.g. /sdcard/Download/)"
                android:textColor="#FFFFFF"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/copyButton"
            style="@style/PremiumButton.Filled"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="ACTIVATE" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Activity Log"
            android:textColor="#8894A8"
            android:textSize="12sp"
            android:letterSpacing="0.08"
            android:paddingTop="24dp"
            android:paddingBottom="6dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#1A1E28"
            android:padding="12dp">

            <TextView
                android:id="@+id/logText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="#C7D1E0"
                android:textSize="12sp" />
        </ScrollView>

    </LinearLayout>
</FrameLayout>
